# FloodGuard AI — Backend Environment Configuration
# Phase-4: Copy to .env and fill in your values

# ─── Core ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development           # development | staging | production
DEBUG=true
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
LOG_LEVEL=INFO

# ─── Database (PostGIS/Supabase) — optional, enables full persistence ─────────
# DATABASE_URL=postgresql+asyncpg://floodguard:password@localhost:5432/floodguard
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here

# ─── Live Weather (OpenWeatherMap) — optional, enables real weather ───────────
# OPENWEATHER_API_KEY=your-key-from-openweathermap.org
WEATHER_POLL_INTERVAL_SECONDS=900   # 15 minutes

# ─── Cache ───────────────────────────────────────────────────────────────────
CACHE_BACKEND=memory               # memory | redis (for production)
# REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_RPM=120                 # Requests per minute per IP
RATE_LIMIT_ENABLED=true

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*                     # In production: https://your-domain.com

# ─── Observability ────────────────────────────────────────────────────────────
ENABLE_METRICS=true
